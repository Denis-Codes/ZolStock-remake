# Copy this file to .env and fill in real values. .env is gitignored.

# Mongo connection. Leave the local default for development, or paste an
# Atlas connection string (mongodb+srv://user:pass@cluster.../) to use Atlas.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=zolstock_db

# Port the API listens on. The frontend's http.service.js expects 3030 in dev.
PORT=3030

# Secret used by cryptr to encrypt the login cookie payload. Changing it
# invalidates every existing session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Comma-separated list of browser origins allowed to send credentialed
# requests. Vite dev server is 5173; add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
