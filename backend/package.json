{
    "name": "server",
    "version": "1.0.0",
    "description": "production ready server",
    "main": "server.js",
    "type": "module",
    "engines": {
        "node": ">=20.15.0 <21",
        "npm": ">=10"
    },
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "server:dev": "nodemon server.js",
        "server:prod": "cross-env NODE_ENV=production node server.js",
        "seed": "node scripts/seed.js",
        "seed:fresh": "node scripts/seed.js --fresh",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:server": "node scripts/test-server.js"
    },
    "author": "Me",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^5.0.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "cryptr": "^6.0.3",
        "dotenv": "^17.4.2",
        "express": "^4.17.1",
        "express-rate-limit": "^8.6.1",
        "helmet": "^8.3.0",
        "mongodb": "^6.6.2",
        "socket.io": "^4.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^3.2.7",
        "cross-env": "^10.1.0",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^2.0.22",
        "supertest": "^7.2.2",
        "vitest": "^3.2.7"
    }
}
