# Loaded by `vite build --mode e2e` (see package.json -> build:e2e).
#
# Vite reads .env first and then .env.[mode], so these two override whatever
# the developer has locally. That is the point: the full-stack E2E bundle must
# be built the same way on every machine and in CI, regardless of what any
# individual .env happens to contain.
#
# No secrets belong in this file. It is committed, unlike .env.

# Use the REAL backend, not the local stub in src/data.
#
# The default browser suite runs the stub on purpose — the GitHub Pages
# deployment is built with `--mode github`, which forces local mode, so that
# suite is testing what actually ships there. This one tests the other
# deployment shape: a real server, a real database, real HTTP.
VITE_LOCAL=false

# Deliberately empty.
#
# product.service.remote.js uses this as the origin prefix for image paths.
# A developer's .env sets it to http://localhost:3030 so the Vite dev server on
# :5173 can load images from the API origin. In the full-stack build there is
# only ONE origin — the test server serves both the SPA and /api — so an empty
# value leaves image paths relative and they resolve correctly.
#
# Left set to :3030, every image in the E2E run would be fetched from the dev
# server instead, which is both wrong and the exact cross-origin confusion this
# stage exists to remove.
VITE_API_URL=
