# Copy this file to .env and adjust. .env is gitignored.
#
# IMPORTANT: every VITE_* variable is compiled into the public JavaScript
# bundle and served to every visitor. They are configuration, NOT secrets.
# Never put an API key here that costs money or grants write access unless it
# is restricted by origin/referrer on the provider's side.

# Catalogue source.
#   true  -> read from src/data/products.json (no backend required)
#   false -> read from the API
# The `github` build mode ignores this and always uses the local service,
# because GitHub Pages serves static files only and has no API behind it.
VITE_LOCAL=false

# Origin used to resolve product image paths returned by the API.
# Leave empty when the API and the app are served from the same origin, which
# is the target architecture (Express serves the built SPA from ./public).
VITE_API_URL=http://localhost:3030
